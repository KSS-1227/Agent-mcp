# ===========================================================================
# Credentials — broad by design; re-admit only the template
# ===========================================================================
.env*
!.env.example
*.pem
*.key
*.p12
credentials.json

# Downloaded Hugging Face caches and local model weights
**/.cache/huggingface/
*.gguf
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt
*.model
*.bin

# ===========================================================================
# Dependencies and build output
# ===========================================================================
node_modules/
**/node_modules/
.next/
**/.next/
out/
**/out/
dist/
**/dist/
*.tsbuildinfo
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# ===========================================================================
# Infrastructure state and benchmark scratch
# ===========================================================================
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
**/bench/raw/
**/bench/tmp/

# ===========================================================================
# Compiler scratch directories
# ===========================================================================
**/.tmp-cjs/
**/.tmp-run/

# ===========================================================================
# Logs, captured output and framework temp state
# ===========================================================================
*.log
*.log.*
*.txt
**/supabase/.temp/
.DS_Store
Thumbs.db

# ===========================================================================
# Test artefacts
# ===========================================================================
coverage/
**/coverage/
.jest-cache/

# ===========================================================================
# Editor / OS
# ===========================================================================
.vscode/
.idea/
*.swp

# ===========================================================================
# The two engines are FIRST-CLASS CONTENT of this repository, tracked as
# ordinary directories rather than submodules. These re-admissions are
# explicit so that no broad rule above can ever swallow them again — an
# unanchored "conflict-engine/" or "recovery-engine/" pattern would also
# match agent-safety-mcp/src/conflict-engine/ and src/recovery-engine/.
# ===========================================================================
!conflict-engine/
!recovery-engine/
