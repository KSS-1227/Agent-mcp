# Standalone Interlock repository configuration only.
# This repository is separate from ../agent-safety-mcp. The integrated
# conflict engine uses that project's shared PostgreSQL/Supabase database and
# does not load this file or require separate subsystem settings.
#
# For this standalone source tree, copy this file to .env.local. scripts/env.js
# loads .env.local (then .env); .env.local is ignored by Git.

# ---------------------------------------------------------------------------
# Required by the standalone repository: CockroachDB
# ---------------------------------------------------------------------------
# The standalone implementation uses CockroachDB-specific SQL and features
# (including the cluster logical clock and AS OF SYSTEM TIME). It is not
# configured for Supabase/PostgreSQL. Use CockroachDB 25.2+ for C-SPANN vectors.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/defaultdb?sslmode=verify-full

# Optional: local PostgreSQL pool size (default: 20).
PG_POOL_MAX=20

# ---------------------------------------------------------------------------
# Optional: AWS-backed features in this standalone repository
# ---------------------------------------------------------------------------
# Bedrock model calls use the AWS SDK credential chain. Set up a local profile
# or use the execution role in AWS; this project does not require long-lived
# AWS keys in this file. Bedrock is used by embedding/adjudication paths.
# This standalone repository uses the Bedrock models listed below; the unified
# Agent Safety MCP Grok provider has its own configuration in that project.
# AWS_PROFILE is optional; omit it to use the SDK's default credential chain.
# AWS_PROFILE=default
# AWS_REGION defaults to us-east-1 (also used by the optional EventBridge CDC path).
AWS_REGION=us-east-1

# Optional Bedrock model overrides (defaults shown).
BEDROCK_MODEL_EMBEDDINGS=amazon.titan-embed-text-v2:0
BEDROCK_MODEL_BULK=us.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_MODEL_ADJUDICATOR=us.anthropic.claude-sonnet-4-6
BEDROCK_MODEL_ESCALATE=us.anthropic.claude-opus-4-5-20251101-v1:0

# ---------------------------------------------------------------------------
# Optional: Cockroach Cloud MCP audit integration
# ---------------------------------------------------------------------------
# Needed only for `npm run mcp`; continuity checks also use these credentials
# when present and otherwise report that the Cockroach Cloud source is unavailable.
# CRDB_MCP_URL defaults to https://cockroachlabs.cloud/mcp.
# Cluster identifier and API key for that integration. The API key is secret;
# set it only in the ignored .env.local file when using this optional feature.
CRDB_CLUSTER_ID=
CCLOUD_API_KEY=
# CRDB_MCP_URL=https://cockroachlabs.cloud/mcp

# ---------------------------------------------------------------------------
# Optional tuning (defaults shown)
# ---------------------------------------------------------------------------
# Cosine distance above which a vector match is too weak to adjudicate.
# Measured with `npm run ai:calibrate`, not guessed. Meaningful only for the
# `<=>` operator -- applying it to `<->` silently disables semantic detection.
SEMANTIC_THRESHOLD=0.58
SEMANTIC_K=10

# Adjudication tier. `bulk` by default: the provenance graph has already
# narrowed the question to a short decision over a candidate list.
ADJUDICATOR_TIER=bulk

# Embed every plan step as well as the intent. Off by default -- the threat
# detector only searches intent embeddings, so this is pure cost on the hot path.
EMBED_PLAN_STEPS=0

# Energy accounting. An estimate, applied uniformly to every benchmark mode so
# the comparison stays valid even if the absolute figure is off.
ENERGY_WH_PER_1K_TOKENS=0.3
GRID_G_CO2E_PER_KWH=379

# Let the adjudicator request one read-only MCP lookup before ruling.
# Costs a second model call; worth it when the ruling matters more than the lookup.
ADJUDICATOR_INVESTIGATE=0
