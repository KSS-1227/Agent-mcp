# Dependencies
node_modules/
yarn.lock

# Environment variables (CRITICAL: prevents credential leakage)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Build outputs
dist/
build/
*.tsbuildinfo

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# Logs (patterns without a slash match at every depth, so *.log covers
# test-run, demo, and crash-drill output written anywhere in this tree)
logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
err.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage reports
coverage/
.nyc_output/

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
.DS_Store

# MCP server cache and state
.mcp-cache/
.mcp-state/
**/supabase/.temp/

# Testing — test files are not published
tests/
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
**/__tests__/
**/__snapshots__/
.jest-cache/

# Keep the deployment transport regression test versioned with its source.
!tests/
tests/*
!tests/mcp/
tests/mcp/*
!tests/mcp/render-http.test.ts
!tests/helpers/
tests/helpers/*
!tests/helpers/live-db-guard.ts
!tests/helpers/live-db-guard.test.ts
!tests/recovery-engine/
tests/recovery-engine/*
!tests/recovery-engine/cloudflare-embedder.test.ts
!tests/recovery-engine/phase-10f.test.ts
!tests/mcp/prepare_action_conflict_gate.test.ts
!tests/mcp/action-lifecycle.test.ts
!tests/conflict-engine/
tests/conflict-engine/*
!tests/conflict-engine/embedding-provenance.test.ts

# Captured output (verification logs and reports, not source)
*.txt

# Phase documentation files (generated during development/testing)
PHASE_*.md
phase*.md
ANCHOR_MIGRATION_*.md
INTERLOCK_INTEGRATION*.md
RECONCILE_ACTION_*.md
SUPABASE_SETUP_GUIDE.md
INDEX.md
