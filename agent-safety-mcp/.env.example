# Supabase/PostgreSQL
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
DATABASE_URL=postgresql://postgres:password@localhost:5432/agent_safety

# LLM Provider
LLM_PROVIDER=nemotron
# Base URL of a separately deployed OpenAI-compatible endpoint (for example, the endpoint's /v1 URL).
# Required: no Hugging Face serverless or hosted endpoint URL is assumed.
NEMOTRON_BASE_URL=
# Hugging Face model identifier sent in chat-completions requests.
NEMOTRON_MODEL=nvidia/NVIDIA-Nemotron-3.5-Bolt-E4B-4GB
# Per-request timeout and output generation controls.
NEMOTRON_TIMEOUT_MS=60000
NEMOTRON_MAX_OUTPUT_TOKENS=768
NEMOTRON_TEMPERATURE=0
# Optional system message prepended to the conflict review prompt.
NEMOTRON_SYSTEM_PROMPT=
# Optional bearer token for authenticated endpoints. Never expose in frontend variables.
HF_TOKEN=
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/Nemotron-3_5-Lightning
NEBIUS_TIMEOUT_MS=30000
NEBIUS_MAX_OUTPUT_TOKENS=768
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
NVIDIA_TIMEOUT_MS=30000
NVIDIA_MAX_OUTPUT_TOKENS=768
BEDROCK_API_KEY=
GROK_REASONING_EFFORT=none
GROK_TIMEOUT_MS=30000
GROQ_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# AWS (for Bedrock)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Configuration
SEMANTIC_THRESHOLD=0.58
SEMANTIC_K=10
LOG_LEVEL=debug

# Entrypoint / transport (read by src/start-server.ts, src/mcp/server.ts)
# stdio is the default local MCP transport; http requires a Supabase JWT and
# listens on 127.0.0.1.
MCP_TRANSPORT=stdio

# HTTP transport listen port.
MCP_HTTP_PORT=8080

# Health endpoint port. Started for both transports.
HEALTH_PORT=8081

# Gates. Each refuses to run unless the flag is set explicitly.
# 1 allows `npm run db:migrate` to apply supabase/migrations.
RUN_DATABASE_MIGRATIONS=0
# 1 allows `npm run demo` and `npm run db:seed` to write demo rows.
RUN_DEMO=0

# Optional runtime integrations
# Required for the github.create_issue executor and production verifier.
# Fine-grained token scoped to this repository; create needs Issues: write, lookup needs Issues: read.
GITHUB_TOKEN=
# Exact owner/repository allowed for GitHub issue actions, e.g. octo-org/widgets.
GITHUB_REPOSITORY=
# Titan Text Embeddings V2 powers the 1024-dimensional episode embedding contract.
BEDROCK_MODEL_EMBEDDINGS=amazon.titan-embed-text-v2:0
# Comma-separated agent ids allowed to perform privileged operations
# (reconciliation). Defaults to the reserved reconciler id when unset.
SYSTEM_AGENT_IDS=
